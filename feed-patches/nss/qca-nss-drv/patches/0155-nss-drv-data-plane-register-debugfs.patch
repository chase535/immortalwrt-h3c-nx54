  * nss_stats_init()
  *	Enable NSS statistics.
  */
+#if defined(NSS_DATA_PLANE_GENERIC_SUPPORT)
+/*
+ * A GMAC armed after the data plane was registered (a runtime fw_mask write)
+ * needs the registration loop run again; nss-dwmac-up writes 1 here after it
+ * arms the mask, and a manual late arm can do the same.
+ */
+static ssize_t nss_data_plane_register_write(struct file *file,
+					     const char __user *ubuf,
+					     size_t count, loff_t *ppos)
+{
+	if (nss_top_main.nss[0].state != NSS_CORE_STATE_INITIALIZED)
+		return -EAGAIN;
+
+	if (!nss_data_plane_schedule_registration())
+		return -EIO;
+
+	return count;
+}
+
+static const struct file_operations nss_data_plane_register_fops = {
+	.write = nss_data_plane_register_write,
+};
+#endif
